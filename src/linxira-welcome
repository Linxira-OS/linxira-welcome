    def _status_page(self):
        page, layout = self._page(self.tr("status"))
        layout.addWidget(self._section_title(self.tr("workstation_status")))
        status = QGridLayout()
        status.setSpacing(12)
        release = self.catalog.get("release", "-") if isinstance(self.catalog, dict) else "-"
        reviewed = self.catalog.get("reviewed", "-") if isinstance(self.catalog, dict) else "-"
        network = self.tr("connected") if self._network_connected() else self.tr("offline")
        catalog_status = self.tr("catalog_available") if isinstance(self.catalog, dict) else self.tr("catalog_unavailable")
        receipt_status = self.receipt.get("status", self.tr("receipt_missing")) if isinstance(self.receipt, dict) else self.tr("receipt_missing")
        update_count, last_check, reboot_required = self._update_state()
        for column, (label, value) in enumerate(
            (
                (self.tr("release"), release),
                (self.tr("kernel"), platform.release()),
                (self.tr("network"), network),
                (self.tr("catalog_review"), f"{catalog_status} / {reviewed}"),
                (self.tr("receipt_status"), receipt_status),
                (self.tr("available_updates"), update_count),
                (self.tr("last_update_check"), last_check),
                (self.tr("reboot_required"), reboot_required),
            )
        ):
            status.addWidget(self._status_tile(label, value), column // 3, column % 3)
        layout.addLayout(status)

        layout.addWidget(self._section_title(self.tr("selection")))
        selection = QFrame()
        selection.setObjectName("panel")
        selection_layout = QVBoxLayout(selection)
        selected = []
        if isinstance(self.receipt, dict):
            profiles = self.receipt.get("profiles", [])
            applications = self.receipt.get("applications", [])
            if isinstance(profiles, list) and isinstance(applications, list):
                selected = profiles + applications
        selection_layout.addWidget(QLabel(", ".join(selected) if selected else self.tr("selection_none")))
        layout.addWidget(selection)

        layout.addStretch()
        return page

    def _terminal_page(self):
        page, layout = self._page(self.tr("terminal_title"))
        body = QLabel(self.tr("terminal_body"))
        body.setObjectName("muted")
        body.setWordWrap(True)
        layout.addWidget(body)
        for name, path, description, leaf_id in SHELL_CHOICES:
            layout.addWidget(self._shell_row(name, path, description, leaf_id))
        layout.addStretch()
        return page

    def _shell_row(self, name, path, description, leaf_id):
        frame = QFrame()
        frame.setObjectName("panel")
        row = QHBoxLayout(frame)
        row.setContentsMargins(18, 14, 18, 14)
        copy = QVBoxLayout()
        title = QLabel(name)
        title_font = title.font()
        title_font.setBold(True)
        title.setFont(title_font)
        copy.addWidget(title)
        detail = QLabel(self.tr(description))
        detail.setObjectName("muted")
        detail.setWordWrap(True)
        copy.addWidget(detail)
        installed = shutil.which(path) is not None or os.access(path, os.X_OK)
        login_shell = self._current_login_shell()
        if login_shell == path:
            state = self.tr("terminal_default")
        elif installed:
            state = self.tr("terminal_installed")
        elif leaf_id is None:
            state = self.tr("terminal_baseline")
        else:
            state = self.tr("terminal_available")
        badge = QLabel(state)
        badge.setObjectName("muted")
        copy.addWidget(badge)
        row.addLayout(copy, 1)
        if leaf_id is not None and not installed:
            executable = self._resolve_app("component_manager")[0]
            available = bool(executable) and (
                shutil.which(executable) is not None or os.access(executable, os.X_OK)
            )
            button = QPushButton(self.tr("terminal_open_manager"))
            button.setProperty("primary", True)
            button.setEnabled(available)
            if not available:
                button.setToolTip(self.tr("terminal_manager_missing"))
            button.clicked.connect(lambda: self._launch_component(leaf_id))
            row.addWidget(button)
        elif installed and login_shell != path:
            button = QPushButton(self.tr("terminal_copy_chsh"))
            button.clicked.connect(lambda: self._copy_command(path))
            row.addWidget(button)
        return frame

    def _current_login_shell(self):
        # 登录 shell 记录在 /etc/passwd; 取不到时退回 $SHELL(仅作展示, 不改任何东西)。
        try:
            import pwd

            return pwd.getpwuid(os.getuid()).pw_shell
        except (ImportError, KeyError, OSError):
            return os.environ.get("SHELL", "")

    def _launch_component(self, leaf_id):
        # 安装事务只发生在 runtime setup 应用里(带 --select 预选); welcome 不做提权。
        executable = self._resolve_app("component_manager")[0]
        if not executable or not QProcess.startDetached(executable, ["--select", leaf_id]):
            QMessageBox.warning(
                self, "Linxira Welcome", self.tr("launch_error", name=self.tr("open_components"))
            )

    def _copy_command(self, path):
