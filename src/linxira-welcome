    def _pending_install_count(self):
        if not isinstance(self.pending_install, dict):
            return 0
        pending = self.pending_install.get("pending")
        if not isinstance(pending, list):
            return 0
        return sum(1 for item in pending if isinstance(item, dict) and item.get("leafId"))

    def _installed_state(self):
        if not isinstance(self.receipt, dict):
            return "health_attention", "completion_unknown"
        receipt_status = self.receipt.get("status")
        if receipt_status in ("installed", "none"):
            # 2026-09-20: 回执恒为 "installed"; 待完成以 itemStatuses/pendingItems
            # 中的显式延后为准(原 status=="deferred" 分支永远不会触发)。
            deferred = self._deferred_component_count() > 0
            health = (
                "health_ready"
                if isinstance(self.catalog, dict) and not deferred
                else "health_attention"
            )
            return health, "completion_pending" if deferred else "completion_complete"
        return "health_attention", "completion_unknown"

    def _catalog_section_ids(self, section):
        catalog = self.catalog if isinstance(self.catalog, dict) else {}
        entries = catalog.get(section)
        if not isinstance(entries, list):
            return set()
        return {
            entry.get("id")
            for entry in entries
            if isinstance(entry, dict) and isinstance(entry.get("id"), str)
        }

    def _deferred_component_count(self):
        # 安装回执里显式延后的叶子; 扣除 applications(package-center 横幅已覆盖)
        # 与桌面, 其余(组件等)由本横幅引导到 Quick System Runtime Setup。
        if not isinstance(self.receipt, dict):
            return 0
        deferred_ids = set()
        item_statuses = self.receipt.get("itemStatuses")
        if isinstance(item_statuses, list):
            deferred_ids |= {
                entry.get("id")
                for entry in item_statuses
                if isinstance(entry, dict)
                and entry.get("status") == "explicitly-deferred"
                and isinstance(entry.get("id"), str)
            }
        pending = self.receipt.get("pendingItems")
        if isinstance(pending, list):
            deferred_ids |= {item for item in pending if isinstance(item, str)}
        applications = self._catalog_section_ids("applications")
        count = 0
        for leaf_id in deferred_ids:
            if leaf_id.startswith("desktop-") or leaf_id in applications:
                continue
            count += 1
        return count

    def _update_state(self):
        if not isinstance(self.update_status, dict) or self.update_status.get("version") != 1:
            unknown = self.tr("unknown")
            return unknown, unknown, unknown
        count = self.update_status.get("available_update_count")
        last_check = self.update_status.get("last_check")
        reboot = self.update_status.get("reboot_required")
        count_text = str(count) if isinstance(count, int) and not isinstance(count, bool) and count >= 0 else self.tr("unknown")
        last_check_text = last_check if isinstance(last_check, str) and last_check else self.tr("unknown")
        reboot_text = self.tr("yes") if reboot is True else self.tr("no") if reboot is False else self.tr("unknown")
        return count_text, last_check_text, reboot_text

