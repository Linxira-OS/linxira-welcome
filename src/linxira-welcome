    def _system_page(self):
        page, layout = self._page(self.tr("system"))
        body = QLabel(self.tr("system_body"))
        body.setObjectName("muted")
        body.setWordWrap(True)
        layout.addWidget(body)
        entries = self._system_entries()
        if not entries:
            empty = QLabel(self.tr("system_unavailable"))
            empty.setObjectName("muted")
            empty.setWordWrap(True)
            layout.addWidget(empty)
        else:
            grid = QGridLayout()
            grid.setHorizontalSpacing(12)
            grid.setVerticalSpacing(12)
            for index, entry in enumerate(entries):
                tile = self._system_tile(entry)
                grid.addWidget(tile, index // 2, index % 2)
            layout.addLayout(grid)
        layout.addStretch()
        return page

    def _system_entries(self):
        """Read the capability manifest and keep the entries meant for Welcome.

        Welcome is an entry point only: it opens the matching ``linxira-config``
        subcommand in a terminal and never mutates the system itself.
        """
        document = read_json(CAPABILITIES_PATH)
        if not isinstance(document, dict):
            return []
        commands = document.get("commands")
        if not isinstance(commands, list):
            return []
        scope = "laptop" if self._is_laptop() else "desktop"
        entries = []
        for command in commands:
            meta = command.get("welcome") if isinstance(command, dict) else None
            if not isinstance(meta, dict):
                continue
            wanted = meta.get("scope", "any")
            if wanted not in ("any", scope):
                continue
            if command.get("mutating") and meta.get("allow_mutating") is not True:
                continue
            entries.append(meta)
        entries.sort(key=lambda item: item.get("order", 100))
        return entries

    def _is_laptop(self):
        try:
            chassis = Path("/sys/class/dmi/id/chassis_type").read_text(encoding="utf-8").strip()
        except OSError:
            return False
        if chassis in ("8", "9", "10", "14", "30", "31", "32"):
            return True
        return any(Path("/sys/class/power_supply").glob("BAT*"))

