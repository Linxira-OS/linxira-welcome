    def _launch_app(self, app, display_name):
        if app == "installer":
            # 2026-08-13: 语言联动 —— welcome 选择的语言写入临时文件,
            # linxira-installer-shell 读取后以该 LANG 启动 calamares。
            try:
                Path("/tmp/linxira-installer-lang").write_text(self.language, encoding="utf-8")
            except OSError:
                pass
        executable, arguments = self._resolve_app(app)
        if not executable or not QProcess.startDetached(executable, list(arguments)):
            QMessageBox.warning(self, "Linxira Welcome", self.tr("launch_error", name=display_name))

    def _resolve_app(self, app):
        # 2026-09-21: 终端与 Config CLI 按桌面环境回退 —— COSMIC 的终端二进制是
        # cosmic-term(Arch 包名 cosmic-terminal, 包名≠二进制名), 依次尝试
        # cosmic-term/konsole/xterm, 保证救援入口始终可用。
        if app in ("terminal", "config"):
            arguments = () if app == "terminal" else ("/usr/bin/linxira-config",)
            for executable, flags in TERMINALS.items():
                if os.access(executable, os.X_OK):
                    return executable, (*flags, *arguments)
            return APPS[app][0], APPS[app][1]
        if app == "settings":
            # 2026-09-21: COSMIC 用 cosmic-settings, KDE 才有 systemsettings。
            for executable in APPS["settings"]:
                if os.access(executable, os.X_OK):
                    return executable, ()
            return APPS["settings"][0], ()
        return APPS[app]

